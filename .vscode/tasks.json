{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "FIMS: Start demo",
      "type": "shell",
      "problemMatcher": [],
      "command": "npm",
      "windows": {
        "command": "npm.cmd"
      },
      "args": [
        "run",
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "FIMS: Build",
      "type": "shell",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$tsc"
      ],
      "command": "npm",
      "windows": {
        "command": "npm.cmd"
      },
      "args": [
        "run",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "FIMS: Run service tests",
      "type": "shell",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "command": "npm",
      "windows": {
        "command": "npm.cmd"
      },
      "args": [
        "run",
        "test"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "FIMS: Run Chrome tests",
      "type": "shell",
      "group": "test",
      "problemMatcher": [],
      "command": "npm",
      "windows": {
        "command": "npm.cmd"
      },
      "args": [
        "run",
        "test:browser"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
